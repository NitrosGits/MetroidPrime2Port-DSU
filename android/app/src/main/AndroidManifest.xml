<?xml version="1.0" encoding="utf-8"?>
<!-- Milestone M1 of docs/ANDROID.md: the smallest app that launches this port on a phone.
     No storage permissions, no file picker: the disc, the user data and the cache
     all live in the app's private files directory for now, which needs no permission, and
     the picker that fills in port_paths.txt is M2. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- SDL's Android haptics call Vibrator.cancel() unconditionally, which throws without
         this and poisons the next JNI call. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The debug console (MP2_CONSOLE) listens on 127.0.0.1: without INTERNET, socket() fails
         with EPERM on Android. It is a loopback socket only; nothing here talks to the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Photo mode's export to Pictures/Metroid Prime 2 on Android 9 (MediaStore needs none on 10+). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- F1 > System > Data folder moves the user data to /storage/emulated/0/MetroidPrime2/, which the
         game reads with plain file calls: all files access on Android 11+, the legacy storage
         permission (WRITE_EXTERNAL_STORAGE above, requested at runtime) on 9-10. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name="org.metroidprime2.port.MetroidPrime2Activity"
            android:alwaysRetainTaskState="true"
            android:configChanges="density|fontScale|fontWeightAdjustment|grammaticalGender|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Ends the game's process and starts it again after a data folder move; its own process, so
             it outlives the one it ends. -->
        <activity
            android:name="org.metroidprime2.port.RestartActivity"
            android:exported="false"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
