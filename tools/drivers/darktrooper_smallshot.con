@f1590 obj u049d
@f1600 place u049d 160 220 -39 180; fsm u049d SmallShotAttack
@f1660 obj u049d
@f1670 place u049d 160 220 -39 90; fsm u049d SmallShotAttack
@f1730 obj u049d
@f1740 press X 8
@f1820 place u049d 160 188 -39 0; fsm u049d SmallShotAttack
@f1900 place u049d 160 195 -39 0; fsm u049d SmallShotAttack
@f1980 place u049d 160 188 -39 180; fsm u049d SmallShotAttack
@f2060 press X 8
