# tail23 bomb chain v4: lay a bomb on the Cyclops' floor and place the Cyclops onto it while it is
# still alive (tight timing), so Patrol's InMaxRange fires -> mBombId -> the bomb states run.
@f600 place u047b 140 205 -13.2
@f620 tp 148 213.3 -13.0
@f640 give morphBallBombs 1
@f660 press x 20
@f700 press a 1
@f704 place u047b 148 213.3 -13.2
@f710 objs CBomb ; trigcall u047b InMaxRange
@f720 trigcall u047b InMaxRange
@f730 obj u047b
@f800 obj u047b
@f850 press a 1
@f870 trigcall u047b InMaxRange ; obj u047b
@f900 obj u047b
@f950 trigcall u047b InMaxRange
@f1000 obj u047b
@f1100 obj u047b
@f1200 obj u047b
@f1300 trigcall u047b InMaxRange ; obj u047b
@f1400 obj u047b
@f1500 obj u047b
@f1600 obj u047b
@f1700 status
