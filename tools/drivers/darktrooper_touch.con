# DarkTrooper (REL 12) Touch, hive_hall: a dead flotsam trooper (ragdoll primed) touches triggers. The
# triggers' fields are forced by tools/cov/specs/darktrooper_touch_force.py (ids are this area's):
#   COV_ROOT=$PWD BUILD=build-port-cov tools/cov/force.sh tools/cov/specs/darktrooper_touch_force.py <out> \
#     3bfa3eff,0e_temple_hive_hall --con tools/drivers/darktrooper_touch.con --fast --frames 1500
