@f756 trigcall u047b InMaxRange
@f770 objs CBomb ; trigcall u047b InMaxRange
@f800 press x 1
@f810 tp 148 211 -11
@f900 obj u047b
@f1080 obj u047b
@f1260 obj u047b
@f1440 obj u047b
@f1620 obj u047b
@f1800 obj u047b
@f1980 obj u047b
