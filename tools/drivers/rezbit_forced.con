# Run: BUILD=build-port-cov tools/cov/run.sh tools/cov/specs/rezbit.py <out> 1baa96c2,02_cliff_reactorcore \
#        --con tools/drivers/rezbit_forced.con --fast --frames 4200
@f600 god 1
@f1000 layer 3
@f1300 layer 4
@f1500 place e0005011b player 15
@f1600 fsm e0005011b FollowAttackPath
@f1900 obj e0005011b
