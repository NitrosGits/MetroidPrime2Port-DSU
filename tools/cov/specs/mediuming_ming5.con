# MediumIng ming5 driver: Dash / SafezoneReaction / MoveToSafeZone / FindSafeZoneRetreatPoint / Find*Actor / SetRetreatDestination / SetLeashTarget arms.
# u0417 = the Ing, u0454 = the Ing next to the Echo zone, u0451 = the Echo safe zone (1105), u0452 its crystal.
# New vars: ming.connrt / ming.conndg <uid> add a Retreat (RTRT) / DeGenerate (DGNR) connection (65535 = no such object, -1 clears).
@f300 god 1; tp 208.5 -174 -46.5; face 180; send u0451 Activate; send u0452 Activate
# --- Dash: total (dest - reflected) zero (0x50C4 false), then remaining zero with total nonzero (0x5110 false), then the normal arm
@f400 place u0417 player 9; place u0417 player 9
@f402 fsm u0417 Dash; var u0417 ming.destme 1
@f403 var u0417 ming.destme 1
@f404 var u0417 ming.inpos 1; statecall u0417 Dash 1 0.033
@f405 obj u0417
@f410 place u0417 player 9; place u0417 player 9
@f412 fsm u0417 Dash; place u0417 player 25; place u0417 player 25; var u0417 ming.destme 1
@f414 obj u0417
@f420 place u0417 player 9; place u0417 player 9
@f422 fsm u0417 Dash; var u0417 ming.destx 150000; var u0417 ming.desty 150000
@f430 obj u0417
@f440 fsm u0417 Idle
# --- SafezoneReaction: mD1 clear (Generate 5) and set (Generate 6)
@f450 fsm u0417 Idle; place u0417 player 9; var u0417 ming.d1 1; fsm u0417 SafezoneReaction
@f452 var u0417 ming.d1 1
@f455 var u0417 ming.d1 1
@f470 obj u0417
@f480 fsm u0417 Idle; place u0417 player 9; var u0417 ming.d1 0; fsm u0417 SafezoneReaction
@f500 obj u0417
@f520 fsm u0417 Idle; place u0417 player 9; var u0417 ming.d1 0; fsm u0417 SafezoneReaction
@f540 obj u0417
@f541 fsm u0417 MistAttack
@f546 obj u0417
@f560 fsm u0417 Idle
# --- FindSafeZoneRetreatPoint / MoveToSafeZone: no zone, a zone id that is not a zone, then the active Echo zone (u0417 then u0454)
@f570 var u0417 ming.safezone -1; fsm u0417 MoveToSafeZone
@f580 obj u0417; fsm u0417 Idle
@f585 var u0417 ming.safezone 1107; fsm u0417 MoveToSafeZone
@f595 obj u0417; fsm u0417 Idle
@f600 var u0417 ming.safezone 1105; fsm u0417 MoveToSafeZone
@f620 obj u0417; fsm u0417 Idle
@f630 var u0454 ming.safezone 1105; fsm u0454 MoveToSafeZone
@f650 obj u0454; fsm u0454 Idle
@f655 var u0417 ming.safezone 1105; pathfail u0417 on; fsm u0417 MoveToSafeZone
@f670 obj u0417; fsm u0417 Idle; pathfail u0417 off
# zone moved off the nav mesh: FindSafeZoneRetreatPoint not-found arm
@f672 place u0451 5000 5000 5000
@f673 var u0417 ming.safezone 1105; fsm u0417 MoveToSafeZone
@f676 obj u0417; fsm u0417 Idle; place u0451 237.9 -194.7 -39.9
# --- SetRetreatDestination / FindClosestRetreatActor: no connection, missing object, zone (active), zone + u0454 both orders, inactive zone
@f680 var u0417 ming.connrt -1; codecall u0417 SetRetreatDestination
@f681 var u0417 ming.connrt 65535; codecall u0417 SetRetreatDestination
@f682 var u0417 ming.connrt -1; var u0417 ming.connrt 1105; codecall u0417 SetRetreatDestination
@f683 var u0417 ming.connrt 1108; var u0417 ming.connrt 1108; codecall u0417 SetRetreatDestination
@f684 var u0417 ming.connrt -1; var u0417 ming.connrt 1105; var u0417 ming.connrt 1108; codecall u0417 SetRetreatDestination
@f685 var u0417 ming.connrt -1; var u0417 ming.connrt 1108; var u0417 ming.connrt 1105; codecall u0417 SetRetreatDestination
@f686 send u0451 Deactivate
@f688 codecall u0417 SetRetreatDestination
@f689 send u0451 Activate; var u0417 ming.connrt -1; codecall u0417 SetRetreatDestination
# --- SetLeashTarget / FindClosestDangerActor: none, missing object, zone, zone + u0454
@f690 var u0417 ming.conndg -1; codecall u0417 SetLeashTarget
@f691 var u0417 ming.conndg 65535; codecall u0417 SetLeashTarget
@f692 var u0417 ming.conndg 1105; var u0417 ming.conndg 1108; codecall u0417 SetLeashTarget
@f693 var u0417 ming.conndg -1; var u0417 ming.conndg 1108; var u0417 ming.conndg 1105; codecall u0417 SetLeashTarget
@f694 var u0417 ming.conndg -1; codecall u0417 SetLeashTarget
@f700 obj u0417
# --- MistAttack: mist set with mD3/fb0 held clear (time arms, exit by time > 1.5), then no mist with mD3 forced (fb0 exit), then the else-if arm (bodystate + statecall)
@f705 place u0417 player 6; var u0417 ming.mist 1; fsm u0417 MistAttack
@f706 var u0417 ming.d3 0; var u0417 ming.fb0 0
@f707 var u0417 ming.d3 0; var u0417 ming.fb0 0
