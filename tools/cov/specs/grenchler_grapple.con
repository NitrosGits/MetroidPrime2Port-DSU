# 08_swamp_grappleguardian_dark (3dfd2249,08_swamp_grappleguardian_dark), layer 3: the guardian u052e
# is put on the grapple chain with forced vars (its vulnerability is 0 for every weapon, as retail's
# 0x10180): gren.scanned/gren.crystal + fsm Pursue, then gren.grappledmg, gren.tail 1 (DestroyTail,
# guardian arm), ShakeOff and a second Pursue.  The @f..5 lines print gren.action every 20 frames.
# Run: tools/cov/run.sh tools/cov/specs/grenchler.py <out> 3dfd2249,08_swamp_grappleguardian_dark --con <this> --fast --frames <past the last @f line>
@f300 layer 3
@f400 god 1; give darkBeam 1; give lightBeam 1; give morphBall 1; give missile 250; give chargeBeam 1; fastmorph 1
@f420 send u052e Activate
@f460 tp -168 25 -28
@f470 face 0
@f500 var u052e gren.scanned 1; var u052e gren.crystal 4; fsm u052e Pursue
@f760 shoot u05bd missile; shoot u05be missile; shoot u05bf missile; shoot u05c0 missile; shoot u05c1 missile; shoot u05c2 missile
@f800 var u052e gren.grappledmg 500
@f1000 var u052e gren.tail 1; objs Tail
@f1100 objs Tail
@f1150 tp -168 25 -28; face 0
@f1160 place u052e player 1
@f1300 fsm u052e ShakeOff
@f1450 tp -168 25 -28; face 0
@f1460 var u052e gren.crystal 4; fsm u052e Pursue
@f1480 press x 8
@f505 obj u052e; var u052e gren.action; status
@f525 obj u052e; var u052e gren.action; status
@f545 obj u052e; var u052e gren.action; status
