# DigitalGuardian area 53 (world 1baa96c2, 09_cliff_temple_dark), dg23: the head's AttachedToBody
# (fn_14_1633C), BombedReaction (fn_14_15CE8) and SeekMotionPath (fn_14_158F8). statecall drives
# msg 3 and the flat-direction arm (dt 0 leaves 0x1028 zero); fsm runs the states naturally;
# `var dghd.stunspeed 0` takes SeekMotionPath's speed-below-epsilon arm.
# Run: BUILD=$PWD/build-port-cov tools/cov/run.sh tools/cov/specs/digitalguardian_states.py <out>
#   1baa96c2,09_cliff_temple_dark --con tools/cov/specs/digitalguardian_dg23.con --fast --frames 900
@f30 layer 3
@f60 layer 11; god 1
@f150 send e00350060 Activate; send e0035000f Activate
@f152 place e0035000f player 20; fsm e0035000f FaceTarget
@f154 statecall e0035000f AttachedToBody 3 0.016; statecall e0035000f BombedReaction 3 0.016; statecall e0035000f SeekMotionPath 3 0.016
# FaceTarget's Deactivate zeroes 0x1028: in the same tick, the update with dt 0 (fn_14_11D64 does
# nothing) sees an unsafe flat direction (a later tick's FaceTarget re-enters and sets it again)
@f156 fsm e0035000f Idle
@f158 statecall e0035000f FaceTarget 2 0.016; statecall e0035000f AttachedToBody 1 0; statecall e0035000f AttachedToBody 2 0.016
# AttachedToBody has no FSM2 node in this area's machine: Activate and updates by statecall
@f160 statecall e0035000f AttachedToBody 0 0.016; statecall e0035000f AttachedToBody 1 0.016; statecall e0035000f AttachedToBody 1 0.016
@f200 fsm e0035000f FaceTarget
# the knock-back: issued, then the body in it (CanIssueCommand false)
@f220 fsm e0035000f BombedReaction
@f260 status; fsm e0035000f FaceTarget
@f270 damage e0035000f 50 bomb
@f300 fsm e0035000f FaceTarget
# no retreat platform yet: Activate and Update find none
@f310 var e0035000f dghd.stunspeed; fsm e0035000f SeekMotionPath
@f330 fsm e0035000f FaceTarget
@f340 codecall e0035000f SelectRetreatPlatform; var e0035000f dghd.stunspeed 0; fsm e0035000f SeekMotionPath
@f360 fsm e0035000f FaceTarget; var e0035000f dghd.stunspeed 20
@f370 fsm e0035000f SeekMotionPath
@f450 obj e0035000f
@f600 obj e0035000f
@f620 fsm e0035000f FaceTarget
# the arrival: at 20 u/s the head never reached the platform in 450 frames (it hardly moves);
# a step longer than the distance takes the Over arm
@f640 place e0035000f player 30; var e0035000f dghd.stunspeed 100000; fsm e0035000f SeekMotionPath
@f700 obj e0035000f
@f860 obj e0035000f; fsm e0035000f FaceTarget
