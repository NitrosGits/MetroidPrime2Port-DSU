@f512 var u05c4 gren.tailhp 100000; var u05c4 gren.sendmsg 101; var u05c4 gren.sendmsg 103
@f514 var u05c4 gren.tailhp 0; var u05c4 gren.sendmsg 303; var u05c4 gren.sendmsg 203
