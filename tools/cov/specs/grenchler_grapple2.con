# 08_swamp_grappleguardian_dark, layer 3: the forced grapple chain on u052e (see grenchler_grapple.con)
# with u04fa placed by the player; press x during the pull, re-forced Pursue, gren.tail 1, ShakeOff, Taunt and u04fa gren.tail 1.
# Run as grenchler_grapple.con.
@f300 layer 3
@f400 god 1; give darkBeam 1; give lightBeam 1; give morphBall 1; give missile 250; give chargeBeam 1; fastmorph 1
@f420 send u052e Activate; obj u04fa
@f460 tp -168 25 -28
@f470 face 0
@f500 var u052e gren.scanned 1; var u052e gren.crystal 4; fsm u052e Pursue
@f735 press x 8
@f1000 press x 8
@f1060 tp -168 25 -28; face 0
@f1070 var u052e gren.crystal 4; fsm u052e Pursue; place u04fa player 6
@f1170 place u04fa player 6
@f1400 tp -168 25 -28; face 0
@f1410 var u052e gren.crystal 4; fsm u052e Pursue
@f1560 tp -168 -70 -28
@f1800 tp -168 25 -28; face 0; var u052e gren.tail 1
@f1850 fsm u052e ShakeOff
@f1855 place u052e player 2
@f1900 fsm u052e Taunt
@f1905 place u052e player 2
@f2000 var u04fa gren.tail 1; objs Tail
@f505 var u052e gren.action; status
