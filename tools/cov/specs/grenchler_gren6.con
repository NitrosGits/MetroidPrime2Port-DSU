# gren6 (gren5 setup): the one-to-three-arm predicates and small bodies forced with gren.lasthit/guardian/x2c/
# launched/flash/fncall; the player is moved with tp/face so IsFacingTarget answers both ways. Forced everywhere.
# Run as grenchler_gren6.con (frames 1500).
@f300 layer 3
@f400 god 1; give morphBall 1; give missile 250
@f420 send u052e Activate; send u04fa Activate
@f460 tp -168 25 -28
@f470 face 0
@f600 var u052e gren.guardian 0; var u052e gren.lasthit 0; var u052e gren.fncall 1; var u052e gren.lasthit 1; var u052e gren.fncall 1
@f610 var u052e gren.guardian 1; var u052e gren.lasthit 0; var u052e gren.fncall 1; var u052e gren.lasthit 1; var u052e gren.fncall 1
@f620 var u052e gren.x2c 0; var u052e gren.fncall 2; var u052e gren.x2c 1; var u052e gren.fncall 2; var u052e gren.x2c 0
@f630 var u052e gren.launched 1; var u052e gren.fncall 3; var u052e gren.launched 0; var u052e gren.fncall 3
@f640 var u052e gren.flash 0; var u052e gren.fncall 4; var u052e gren.flash 5; var u052e gren.fncall 4
@f650 var u052e gren.fncall 5; var u052e gren.fncall 6
@f660 var u052e gren.turn 1
@f670 var u052e gren.guardian 0; var u052e gren.lasthit 0; var u052e gren.fncall 1; var u052e gren.lasthit 1; var u052e gren.fncall 1; var u052e gren.fncall 2; var u052e gren.turn 0; var u052e gren.fncall 1
@f680 var u052e gren.guardian 1; var u052e gren.lasthit 0; var u052e gren.fncall 1; var u052e gren.lasthit 1; var u052e gren.fncall 1
@f690 var u052e gren.turn 1; var u052e gren.guardian 0; var u052e gren.lasthit 0; var u052e gren.fncall 1; var u052e gren.guardian 1; var u052e gren.fncall 1; var u052e gren.lasthit 1; var u052e gren.fncall 1
# gren2: visor-effect trio, live and null-token arms (fncall 7-13); face 0 keeps the player looking at the Grenchler
@f700 var u052e gren.fncall 7; var u052e gren.fncall 8; var u052e gren.fncall 9
@f710 var u052e gren.fncall 10; var u052e gren.fncall 11
@f720 var u052e gren.fncall 12; var u052e gren.fncall 13; tp -168 25 -28; face 0; var u052e gren.fncall 12; var u052e gren.fncall 13
@f730 face 180; var u052e gren.fncall 12; face 0; tp -168 80 -28; var u052e gren.fncall 12; tp -168 25 -28
@f740 tp -168 90 -28
@f745 var u052e gren.fncall 12
@f750 tp -168 25 -28
# gren3: 7BA4 skip arm (fncall 14 moves the Grenchler 40 along the line of sight), SpawnTail F1C8 (15-18),
# MarkPathRegion E390 (19), GetManeuverTarget 5640 (20), FindJumpPoint E634 (21)
@f760 var u052e gren.fncall 14; var u052e gren.fncall 15; var u052e gren.fncall 16; var u052e gren.fncall 17; var u052e gren.fncall 18
@f770 var u052e gren.fncall 19; var u052e gren.fncall 20; var u052e gren.fncall 21
# gren3 maneuver hints (none first = null result), then each reject arm, hidden, far, visible; MarkPathRegion after searches
@f780 var u052e gren.fncall 20; var u052e gren.mhint 3; var u052e gren.mhint 2; var u052e gren.mhint 6; var u052e gren.fncall 20
@f785 var u052e gren.mhint 5; var u052e gren.fncall 20; var u052e gren.mhint 4; var u052e gren.fncall 20
@f790 var u052e gren.mhint 1; var u052e gren.fncall 20; var u052e gren.mhint 1; var u052e gren.fncall 20
@f800 var u052e gren.path 1; var u052e gren.fncall 19; var u052e gren.fncall 19; var u052e gren.fncall 22; var u052e gren.fncall 19
@f805 var u052e gren.path 3; var u052e gren.fncall 22; var u052e gren.fncall 19; var u052e gren.path 4; var u052e gren.fncall 22; var u052e gren.fncall 19
@f810 var u052e gren.path 2; var u052e gren.fncall 22; var u052e gren.fncall 19
