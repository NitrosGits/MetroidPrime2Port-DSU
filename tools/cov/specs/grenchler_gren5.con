# gren5 (gren4 driver +): 08_swamp_grappleguardian_dark layer 3, u052e and u04fa activated and standing; the missing
# arms of the near-complete bodies forced with the gren.* vars, statecall (msg 3 = the switch default)
# and trigcall. Forced everywhere. Run as grenchler_grapple.con (frames 2200).
@f300 layer 3
@f400 god 1; give morphBall 1; give missile 250
@f420 send u052e Activate; send u04fa Activate
@f460 tp -168 25 -28
@f470 face 0
@f600 var u052e gren.submerged 1; statecall u052e Patrol 1; var u052e gren.submerged 0
@f610 statecall u052e PauseBetweenBites 0; statecall u052e PauseBetweenBites 1; statecall u052e PauseBetweenBites 2; statecall u052e PauseBetweenBites 3
@f620 statecall u052e Patrol 0; statecall u052e Patrol 3
@f640 statecall u052e GrappleSlide 3
@f642 statecall u052e GrappleSlide 0; var u052e gren.hitzero 1; statecall u052e GrappleSlide 1 0.016
@f644 var u052e gren.slideold 1; statecall u052e GrappleSlide 1 0.016; statecall u052e GrappleSlide 2
@f650 statecall u052e GrappleSlideBonk 3
@f652 statecall u052e GrappleSlideBonk 0; statecall u052e GrappleSlideBonk 1; var u052e gren.slideold 1; statecall u052e GrappleSlideBonk 1; statecall u052e GrappleSlideBonk 2
@f660 statecall u052e Charge 3
@f670 statecall u052e GrappleStruggle 3
@f680 var u052e gren.trace 2; statecall u052e GrappleBreak 0; var u052e gren.trace 0; statecall u052e GrappleBreak 0; statecall u052e GrappleBreak 3
@f690 trigcall u052e BeamHitWall; var u052e gren.beamlen 100; trigcall u052e BeamHitWall; var u052e gren.beamlen 1; var u052e gren.trace 2; trigcall u052e BeamHitWall; var u052e gren.trace 0
@f700 var u052e gren.x24 5; trigcall u052e BeamBadAngle; var u052e gren.x24 0; trigcall u052e BeamBadAngle
@f710 var u052e gren.side 2; statecall u052e GrappleLoop 0; var u052e gren.side 0; statecall u052e GrappleLoop 0; var u052e gren.side 1; statecall u052e GrappleLoop 0; var u052e gren.side -1; statecall u052e GrappleLoop 0
@f720 var u052e gren.startbeam 2
@f730 var u052e gren.recreate 1
@f740 var u052e gren.recreate 2
@f750 var u052e gren.attach 1; var u052e gren.attach 0; var u052e gren.attach 0
@f760 var u052e gren.struggle 0; trigcall u052e StopStruggling; var u052e gren.struggle 1; var u052e gren.struggle 3; trigcall u052e StopStruggling; var u052e gren.struggle 2; trigcall u052e StruggleOver; var u052e gren.struggle 3; trigcall u052e StruggleOver
@f770 trigcall u052e ShouldSlide; trigcall u052e ShouldBackstep
@f780 var u052e gren.tail 1
@f800 var u04fa gren.tail 1; send u04fa HitObject
@f815 var u052e gren.contact 0; var u052e gren.contact 1; var u052e gren.contact 2; var u052e gren.contact 3
@f816 statecall u052e PauseBetweenBites 0; statecall u052e PauseBetweenBites 3
@f817 var u052e gren.path 1; statecall u052e Charge 0; statecall u052e Charge 1 0.016; var u052e gren.path 2; statecall u052e Charge 1 0.016; var u052e gren.path 3; statecall u052e Charge 1 0.016; var u052e gren.path 2; statecall u052e Charge 1 0.016; var u052e gren.path 4; var u052e gren.path 2; var u052e gren.path 2; var u052e gren.path 2; statecall u052e Charge 1 0.016
@f818 var u052e gren.hitzero 2; statecall u052e GrappleSlide 0; statecall u052e GrappleSlide 1 0.016; var u052e gren.slidestart 5; statecall u052e GrappleSlide 1 0.016; var u052e gren.slideold 1; statecall u052e GrappleSlide 1 0.016
@f819 statecall u052e GrappleSlideBonk 0; var u052e gren.slidestart 0; statecall u052e GrappleSlideBonk 1 0.016; var u052e gren.slideold 1; statecall u052e GrappleSlideBonk 1 0.016
@f821 var u052e gren.swoosh 0; trigcall u052e BeamBadAngle; var u052e gren.swoosh 1; trigcall u052e BeamBadAngle; var u052e gren.swoosh 2; trigcall u052e BeamBadAngle; var u052e gren.swoosh 3; trigcall u052e BeamBadAngle; var u052e gren.swoosh 4; trigcall u052e BeamBadAngle; var u052e gren.swoosh 0
@f822 statecall u052e BeamAttack 0; statecall u052e BeamAttack 1; statecall u052e BeamAttack 2; statecall u052e BeamAttack 1; statecall u052e BeamAttack 3
@f823 statecall u052e Taunt 0; statecall u052e Taunt 1; statecall u052e Taunt 2; statecall u052e Taunt 1; statecall u052e Taunt 3
@f824 statecall u052e BiteAttack 0; statecall u052e BiteAttack 1; statecall u052e BiteAttack 2; statecall u052e BiteAttack 1; statecall u052e BiteAttack 3
@f825 statecall u052e Backstep 0; statecall u052e Backstep 1; statecall u052e Backstep 2; statecall u052e Backstep 1; statecall u052e Backstep 3
@f826 statecall u052e MorphballBite 0; statecall u052e MorphballBite 1; statecall u052e MorphballBite 2; statecall u052e MorphballBite 1; statecall u052e MorphballBite 3
@f830 var u052e gren.hint 3; var u052e gren.hint 4; var u052e gren.hint 5; var u052e gren.hint 8; var u052e gren.hint 2; var u052e gren.hint 7; var u052e gren.hintcall 1; var u052e gren.hintcall 2; var u052e gren.hintcall 3
@f840 var u052e gren.hint 1; var u052e gren.hintcall 1
@f850 var u052e gren.hint 6; var u052e gren.hintcall 2
@f860 var u052e gren.jumpcost 1; var u052e gren.jumpcost 2; var u052e gren.jumpcost 3; var u052e gren.jumpcost 4; var u052e gren.jumpcost 5
