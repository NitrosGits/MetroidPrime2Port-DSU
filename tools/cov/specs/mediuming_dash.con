# mediuming_states.py SetDashDestination driver (mi4): player inside the active safe zone u0451, u0454 placed
# around the player so its dash candidates land in the zone (0x298C).
@f300 god 1; send u0451 Activate; send u0452 Activate; tp 237.9 -194.7 -39.9; face 180
@f400 place u0454 player 9; shoot u0454; obj u0454
