# Cross-compile for Windows x86_64 with an llvm-mingw toolchain.
# Pass -DLLVM_MINGW_ROOT=<dir> or set the LLVM_MINGW_ROOT environment variable.
if(NOT LLVM_MINGW_ROOT AND DEFINED ENV{LLVM_MINGW_ROOT})
    # Cached so that a later "Re-running CMake" from ninja does not need the environment.
    set(LLVM_MINGW_ROOT "$ENV{LLVM_MINGW_ROOT}" CACHE PATH "llvm-mingw toolchain root")
endif()
if(NOT LLVM_MINGW_ROOT)
    message(FATAL_ERROR "Set LLVM_MINGW_ROOT to the llvm-mingw toolchain root")
endif()
set(_triple x86_64-w64-mingw32)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER   "${LLVM_MINGW_ROOT}/bin/${_triple}-clang")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/${_triple}-clang++")
set(CMAKE_RC_COMPILER  "${LLVM_MINGW_ROOT}/bin/llvm-rc")
set(CMAKE_AR           "${LLVM_MINGW_ROOT}/bin/llvm-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB       "${LLVM_MINGW_ROOT}/bin/llvm-ranlib" CACHE FILEPATH "")
set(CMAKE_OBJCOPY      "${LLVM_MINGW_ROOT}/bin/llvm-objcopy" CACHE FILEPATH "")
set(CMAKE_NM           "${LLVM_MINGW_ROOT}/bin/llvm-nm" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW_ROOT}/${_triple}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
